---
// Guides index — the hub for the evergreen half of the content, and the crawl
// path into every individual guide.
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { GUIDES } from "../../lib/guides";

const title = "Cross-timezone scheduling guides — meetwhen.xyz";
const description =
  "Practical guides to scheduling across timezones: rotating meeting times fairly, handling pairs with no overlap, and surviving daylight saving on recurring calls.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://meetwhen.xyz/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://meetwhen.xyz/guides/" },
    ],
  },
];
---

<Layout>
  <Fragment slot="head">
    <PageHead title={title} description={description} path="/guides/" jsonLd={jsonLd} />
  </Fragment>

  <main class="min-h-screen bg-background text-foreground">
    <div class="mx-auto max-w-3xl px-4 py-10 md:py-16">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-muted-foreground">
        <a href="/" class="hover:underline">meetwhen.xyz</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">guides</span>
      </nav>

      <header class="mb-10">
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">
          Cross-timezone scheduling guides
        </h1>
        <p class="mt-3 text-muted-foreground">
          The planner answers <em>when</em>. These answer <em>how to run it</em> — the parts of
          distributed scheduling that no amount of timezone arithmetic will fix for you.
        </p>
      </header>

      <ul class="space-y-4">
        {
          GUIDES.map((g) => (
            <li class="rounded-lg border border-border bg-card p-5">
              <h2 class="font-medium">
                <a href={`/guides/${g.slug}/`} class="hover:underline">
                  {g.h1}
                </a>
              </h2>
              <p class="text-sm text-muted-foreground mt-1">{g.blurb}</p>
            </li>
          ))
        }
      </ul>

      <footer class="mt-16 pt-6 border-t border-border text-xs text-muted-foreground">
        <a href="/" class="underline">Planner</a>
        <span class="mx-2">·</span>
        <a href="/meet/" class="underline">All cities</a>
      </footer>
    </div>
  </main>
</Layout>
