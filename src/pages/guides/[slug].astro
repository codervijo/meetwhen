---
// One page per evergreen scheduling guide. Content lives in src/lib/guides.ts
// as structured blocks so the markup stays consistent across all of them.
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { GUIDES, type Guide } from "../../lib/guides";
import { HUB_PAIRS } from "../../lib/cities";

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const path = `/guides/${guide.slug}/`;

const others = GUIDES.filter((g) => g.slug !== guide.slug);
// A handful of pair pages so guides feed the pSEO tree rather than dead-ending.
const samplePairs = HUB_PAIRS.filter((_, i) => i % Math.ceil(HUB_PAIRS.length / 8) === 0).slice(0, 8);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.h1,
    description: guide.description,
    mainEntityOfPage: `https://meetwhen.xyz${path}`,
    publisher: { "@id": "https://meetwhen.xyz/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://meetwhen.xyz/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://meetwhen.xyz/guides/" },
      { "@type": "ListItem", position: 3, name: guide.h1, item: `https://meetwhen.xyz${path}` },
    ],
  },
];
---

<Layout>
  <Fragment slot="head">
    <PageHead
      title={guide.title}
      description={guide.description}
      path={path}
      ogTitle={guide.h1}
      jsonLd={jsonLd}
    />
  </Fragment>

  <main class="min-h-screen bg-background text-foreground">
    <div class="mx-auto max-w-3xl px-4 py-10 md:py-16">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-muted-foreground">
        <a href="/" class="hover:underline">meetwhen.xyz</a>
        <span class="mx-1">/</span>
        <a href="/guides/" class="hover:underline">guides</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{guide.h1}</span>
      </nav>

      <article>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">{guide.h1}</h1>
        <p class="mt-3 text-lg text-muted-foreground">{guide.blurb}</p>

        <div class="mt-10 space-y-5">
          {
            guide.body.map((block) => {
              if (block.kind === "h")
                return (
                  <h2 class="text-xl font-semibold tracking-tight pt-4">{block.text}</h2>
                );
              if (block.kind === "p")
                return <p class="text-muted-foreground leading-relaxed">{block.text}</p>;
              if (block.kind === "ul")
                return (
                  <ul class="list-disc pl-5 space-y-2 text-muted-foreground">
                    {block.items.map((i) => (
                      <li class="leading-relaxed">{i}</li>
                    ))}
                  </ul>
                );
              return (
                <ol class="list-decimal pl-5 space-y-2 text-muted-foreground">
                  {block.items.map((i) => (
                    <li class="leading-relaxed">{i}</li>
                  ))}
                </ol>
              );
            })
          }
        </div>
      </article>

      <aside class="mt-14 rounded-lg border border-border bg-card p-6">
        <h2 class="text-lg font-medium mb-2">Try it on your own team</h2>
        <p class="text-sm text-muted-foreground mb-4">
          Add everyone's cities and real hours, and the planner ranks the slots by how small
          and how evenly shared the compromise is.
        </p>
        <a
          href="/"
          class="inline-block rounded-md border border-border bg-background px-4 py-2 text-sm hover:bg-accent transition-colors"
        >
          Open the planner →
        </a>
      </aside>

      <section aria-labelledby="more-guides" class="mt-14">
        <h2 id="more-guides" class="text-2xl font-semibold tracking-tight mb-4">More guides</h2>
        <ul class="space-y-3">
          {
            others.map((g) => (
              <li class="rounded-lg border border-border bg-card p-4">
                <a href={`/guides/${g.slug}/`} class="font-medium hover:underline">
                  {g.h1}
                </a>
                <p class="text-sm text-muted-foreground mt-1">{g.blurb}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="pairs" class="mt-12">
        <h2 id="pairs" class="text-sm font-medium text-muted-foreground uppercase tracking-wide mb-3">
          Popular city pairs
        </h2>
        <ul class="flex flex-wrap gap-2">
          {
            samplePairs.map((p) => (
              <li>
                <a
                  href={`/meet/${p.a.slug}/${p.b.slug}/`}
                  class="inline-block rounded-md border border-border bg-card px-3 py-1.5 text-sm hover:bg-accent transition-colors"
                >
                  {p.a.name} ↔ {p.b.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted-foreground">
          Or see <a href="/meet/" class="underline">all cities and pairs</a>.
        </p>
      </section>
    </div>
  </main>
</Layout>
