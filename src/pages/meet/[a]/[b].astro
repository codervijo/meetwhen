---
// City-pair meeting planner. One page per unordered pair of hub cities
// (~250 pages). Each renders the ranked slots as real HTML, then hydrates the
// full planner pre-filled with the same two cities.
import { DateTime } from "luxon";
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import StaticSlots from "../../../components/StaticSlots.astro";
import TimezoneTool from "../../../components/TimezoneTool.tsx";
import { HUB_PAIRS, pairsFor, utcOffsetLabel, type City } from "../../../lib/cities";
import {
  BUILD_DATE,
  dstSentence,
  gapHours,
  gapRange,
  hoursPhrase,
  overlapHours,
} from "../../../lib/facts";
import { staticParticipant } from "../../../lib/schedule";

export function getStaticPaths() {
  return HUB_PAIRS.map(({ a, b }) => ({
    params: { a: a.slug, b: b.slug },
    props: { a, b },
  }));
}

interface Props {
  a: City;
  b: City;
}

const { a, b } = Astro.props;
const date = BUILD_DATE;
const path = `/meet/${a.slug}/${b.slug}/`;

const participants = [staticParticipant(a, a.name, 0), staticParticipant(b, b.name, 1)];
const gap = gapHours(a, b, date);
const range = gapRange(a, b);
const overlap = overlapHours(a, b, date);
const ahead = gap === 0 ? null : gap > 0 ? b : a;
const behind = ahead ? (ahead.slug === a.slug ? b : a) : null;

const title = `Best time to meet between ${a.name} and ${b.name} — meetwhen.xyz`;
const description =
  overlap > 0
    ? `${a.name} and ${b.name} share ${overlap} hours of overlapping working time. See the ranked meeting slots in both local times, and adjust for your own hours.`
    : `${a.name} and ${b.name} have no overlapping 9–5 window. See the ranked meeting slots that split the difference most fairly, in both local times.`;

// Related pairs, for internal linking. Trimmed to keep the link block scannable.
const related = [...pairsFor(a), ...pairsFor(b)]
  .filter((p) => !(p.a.slug === a.slug && p.b.slug === b.slug))
  .filter(
    (p, i, arr) =>
      arr.findIndex((q) => q.a.slug === p.a.slug && q.b.slug === p.b.slug) === i,
  )
  .slice(0, 12);

const FAQS = [
  {
    q: `What is the time difference between ${a.name} and ${b.name}?`,
    a: range.varies
      ? `On ${DateTime.fromISO(date).toFormat("d LLLL yyyy")} the gap is ${hoursPhrase(gap)}${
          ahead ? `, with ${ahead.name} ahead of ${behind!.name}` : ""
        }. Across the year it moves between ${hoursPhrase(range.min)} and ${hoursPhrase(range.max)} because of daylight saving.`
      : `${
          gap === 0
            ? `${a.name} and ${b.name} keep the same clock time.`
            : `${ahead!.name} is ${hoursPhrase(gap)} ahead of ${behind!.name}.`
        } The gap does not change through the year.`,
  },
  {
    q: `Do ${a.name} and ${b.name} have overlapping working hours?`,
    a:
      overlap > 0
        ? `Yes — ${overlap} hours overlap if both sides work 9:00 to 17:00 local time. That window is where the top-ranked slots on this page come from.`
        : `No. With standard 9:00–17:00 hours on both sides there is no shared window, so one person has to take the call outside their normal day. The ranking on this page picks the option that costs the least and spreads it as evenly as possible.`,
  },
  {
    q: `Does this account for daylight saving?`,
    a: dstSentence(a, b),
  },
  {
    q: `Can I add more people or change the working hours?`,
    a: `Yes. The planner on this page starts with ${a.name} and ${b.name} on 9:00–17:00, and you can change either city's hours, pick a different date, or add up to eight participants. Nothing is sent to a server.`,
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://meetwhen.xyz/" },
      { "@type": "ListItem", position: 2, name: "Cities", item: "https://meetwhen.xyz/meet/" },
      {
        "@type": "ListItem",
        position: 3,
        name: a.name,
        item: `https://meetwhen.xyz/meet/${a.slug}/`,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: `${a.name} and ${b.name}`,
        item: `https://meetwhen.xyz${path}`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQS.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout>
  <Fragment slot="head">
    <PageHead
      title={title}
      description={description}
      path={path}
      ogTitle={`${a.name} ↔ ${b.name} meeting planner`}
      jsonLd={jsonLd}
    />
  </Fragment>

  <main class="min-h-screen bg-background text-foreground">
    <div class="mx-auto max-w-5xl px-4 py-10 md:py-16">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-muted-foreground">
        <a href="/" class="hover:underline">meetwhen.xyz</a>
        <span class="mx-1">/</span>
        <a href="/meet/" class="hover:underline">cities</a>
        <span class="mx-1">/</span>
        <a href={`/meet/${a.slug}/`} class="hover:underline">{a.name}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{b.name}</span>
      </nav>

      <header class="mb-8">
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">
          Best time to meet between {a.name} and {b.name}
        </h1>
        <p class="mt-3 text-muted-foreground max-w-2xl">
          {
            gap === 0
              ? `${a.name} and ${b.name} run on the same clock, so any time that works for one works for the other.`
              : `${ahead!.name} is ${hoursPhrase(gap)} ahead of ${behind!.name} on ${DateTime.fromISO(date).toFormat("d LLLL yyyy")}.`
          }
          {
            overlap > 0
              ? ` Their standard working days overlap by ${overlap} hours.`
              : ` Their standard working days do not overlap at all.`
          }
        </p>

        <dl class="mt-6 grid gap-3 sm:grid-cols-3 text-sm">
          <div class="rounded-lg border border-border bg-card p-4">
            <dt class="text-xs text-muted-foreground mb-1">{a.name}</dt>
            <dd class="font-medium">{utcOffsetLabel(a.tz, date)}</dd>
            <dd class="text-xs text-muted-foreground font-mono mt-0.5">{a.tz}</dd>
          </div>
          <div class="rounded-lg border border-border bg-card p-4">
            <dt class="text-xs text-muted-foreground mb-1">{b.name}</dt>
            <dd class="font-medium">{utcOffsetLabel(b.tz, date)}</dd>
            <dd class="text-xs text-muted-foreground font-mono mt-0.5">{b.tz}</dd>
          </div>
          <div class="rounded-lg border border-border bg-card p-4">
            <dt class="text-xs text-muted-foreground mb-1">Shared working hours</dt>
            <dd class="font-medium">{overlap > 0 ? `${overlap} hours` : "None"}</dd>
            <dd class="text-xs text-muted-foreground mt-0.5">at 9:00–17:00 each</dd>
          </div>
        </dl>
      </header>

      <TimezoneTool
        client:load
        prefill={[
          { name: a.name, tz: a.tz, cityName: a.name, start: 9, end: 17 },
          { name: b.name, tz: b.tz, cityName: b.name, start: 9, end: 17 },
        ]}
      />

      <StaticSlots participants={participants} dateISO={date} />

      <section aria-labelledby="dst" class="mt-14">
        <h2 id="dst" class="text-2xl font-semibold tracking-tight mb-3">
          Daylight saving between {a.name} and {b.name}
        </h2>
        <p class="text-muted-foreground max-w-3xl">{dstSentence(a, b)}</p>
      </section>

      <section aria-labelledby="faq" class="mt-14">
        <h2 id="faq" class="text-2xl font-semibold tracking-tight mb-6">
          Questions about {a.name} ↔ {b.name} meetings
        </h2>
        <dl class="space-y-4">
          {
            FAQS.map((f) => (
              <div class="rounded-lg border border-border bg-card p-5">
                <dt class="font-medium mb-1">{f.q}</dt>
                <dd class="text-sm text-muted-foreground">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="related" class="mt-14">
        <h2 id="related" class="text-2xl font-semibold tracking-tight mb-4">Related pairs</h2>
        <ul class="flex flex-wrap gap-2">
          {
            related.map((p) => (
              <li>
                <a
                  href={`/meet/${p.a.slug}/${p.b.slug}/`}
                  class="inline-block rounded-md border border-border bg-card px-3 py-1.5 text-sm hover:bg-accent transition-colors"
                >
                  {p.a.name} ↔ {p.b.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted-foreground">
          Or browse every city on the <a href="/meet/" class="underline">city index</a>, or read
          the <a href="/guides/" class="underline">scheduling guides</a>.
        </p>
      </section>

      <footer class="mt-16 pt-6 border-t border-border text-xs text-muted-foreground">
        Times computed from the IANA timezone database for
        {" "}{DateTime.fromISO(date).toFormat("d LLLL yyyy")}. Runs entirely in your browser — no
        accounts, no tracking.
      </footer>
    </div>
  </main>
</Layout>
